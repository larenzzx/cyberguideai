SECRET_KEY=change-this-to-a-long-random-secret
DEBUG=False

# Replace with your Ubuntu server IP or local DNS name.
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.50,cyberguide.local
CSRF_TRUSTED_ORIGINS=http://192.168.1.50:8000,http://cyberguide.local:8000

# App port exposed on the Ubuntu server.
APP_PORT=8000

# Local PostgreSQL container credentials.
POSTGRES_DB=cyberguideai
POSTGRES_USER=cyberguideai
POSTGRES_PASSWORD=change-this-local-db-password

# Optional API keys. Leave blank if you only want the UI/auth to run.
GROQ_API_KEY=
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=
